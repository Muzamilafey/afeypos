{
  "name": "@afeypos/shop",
  "version": "0.1.0",
  "private": true,
  "description": "Afey POS online shop: the customer-facing shopping website, connected to the head-office server",
  "type": "module",
  "scripts": {
    "predev": "npm run build --prefix ../packages/shared",
