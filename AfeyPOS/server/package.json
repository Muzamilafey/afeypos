{
  "name": "@afeypos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx --env-file-if-exists=.env src/scripts/seedDemo.ts",
    "backup": "tsx --env-file-if-exists=.env src/scripts/backup.ts",
    "restore": "tsx --env-file-if-exists=.env src/scripts/restore.ts",
    "reset-password": "tsx --env-file-if-exists=.env src/scripts/resetPassword.ts"
  },
  "dependencies": {
    "@afeypos/shared": "0.1.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.19.1",
    "nodemailer": "7.0.9",
    "pdfkit": "0.17.2",
    "pino": "10.0.0",
    "qrcode-generator": "1.4.4",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.8",
    "@types/nodemailer": "7.0.2",
    "@types/pdfkit": "0.17.2",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.2.3",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
}
