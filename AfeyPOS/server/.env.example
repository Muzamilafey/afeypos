# Afey POS server configuration. Copy to .env and replace every placeholder.
# Never commit the real .env file.

NODE_ENV=development
PORT=9999
HOST=0.0.0.0

# One business per installation.
#   standalone = a single shop (one server and database)
#   hq         = the online head-office server: admins work here, every branch syncs to it, serves the online shop
#   branch     = the local server in one branch (own database, keeps selling offline) that syncs with HQ
DEPLOYMENT_MODE=standalone
# branch role only: the branch code as created at head office
BRANCH_CODE=

# A replica set is required for transactions (a single-node replica set is fine). See docs/DATABASE.md
MONGODB_URI=mongodb://127.0.0.1:27017/afeypos?replicaSet=rs0
MONGODB_REQUIRE_REPLICA_SET=true
# Only for a MongoDB that needs a login (authentication enabled). Leave empty for the database the installer
# runs for Afey POS (no login, listens on 127.0.0.1 only). Replace with the real user and password; special
# characters are fine here (no URL-encoding needed). The user needs readWrite on the afeypos database
# (and clusterMonitor to check the replica set); MONGODB_AUTH_SOURCE is where the user was created.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
# The same in one line instead (password URL-encoded):
# MONGODB_URI=mongodb://USERNAME:PASSWORD@127.0.0.1:27017/afeypos?replicaSet=rs0&authSource=admin

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored integration secrets, 2FA secrets and fingerprint templates unreadable. Back it up.
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Address of the web app (used in emailed links)
PUBLIC_APP_URL=http://localhost:5173
# Public HTTPS URL Safaricom can reach for M-Pesa callbacks
API_PUBLIC_URL=http://localhost:9999
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=loopback
# true when served over HTTPS
COOKIE_SECURE=false

# Server email for password resets when no SMTP integration is set in Settings > Integrations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Afey POS <no-reply@example.com>

# Optional comma-separated Safaricom callback source IPs to allow (leave empty to rely on the secret callback URL)
MPESA_ALLOWED_IPS=

UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
JOBS_ENABLED=true
LOG_LEVEL=info

# Serve the built web app from this server
WEB_DIST_DIR=../web/dist
# Online shop website served for these host names (comma separated), e.g. shop.mysupermarket.co.ke
SHOP_DIST_DIR=../shop/dist
SHOP_HOSTNAMES=
# Sites that may show the shop inside the Store studio preview (the POS address), comma separated
SHOP_FRAME_ANCESTORS=

# Branch <-> head office sync (branch role)
SYNC_ENABLED=false
SYNC_HQ_URL=
SYNC_TOKEN=
