# Afey POS server configuration. Copy to .env and replace every placeholder.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# local = single business installation (Windows shop server); cloud = multi-tenant SaaS
DEPLOYMENT_MODE=local

# A replica set is required for transactions (a single-node replica set is fine). See docs/DATABASE.md
MONGODB_URI=mongodb://127.0.0.1:27017/afeypos?replicaSet=rs0
MONGODB_REQUIRE_REPLICA_SET=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored integration secrets, 2FA secrets and fingerprint templates unreadable. Back it up.
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Cloud: tenants live at <subdomain>.<BASE_DOMAIN>; the platform portal at <PLATFORM_SUBDOMAIN>.<BASE_DOMAIN>
BASE_DOMAIN=afeypos.com
PLATFORM_SUBDOMAIN=admin
PUBLIC_APP_URL=http://localhost:5173
# Public HTTPS URL Safaricom can reach for M-Pesa callbacks
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# Development only: lets the web dev server pick a tenant with the X-Tenant header. Must be false in production.
ALLOW_TENANT_HEADER=false
TRUST_PROXY=loopback
# true when served over HTTPS
COOKIE_SECURE=false

# Cloud only: creates the first platform owner on first start, then remove the password
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# Platform email (password resets etc.). Tenants can configure their own SMTP in Settings > Integrations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Afey POS <no-reply@example.com>

# Optional comma-separated Safaricom callback source IPs to allow (leave empty to rely on the secret callback URL)
MPESA_ALLOWED_IPS=

UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
JOBS_ENABLED=true
LOG_LEVEL=info

# Local installations: serve the built web app from this server
WEB_DIST_DIR=../web/dist

# Optional hybrid sync (local -> cloud)
SYNC_ENABLED=false
SYNC_CLOUD_URL=
SYNC_TOKEN=
